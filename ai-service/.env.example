# Plane instance (inside docker-compose: http://api:8000)
PLANE_BASE_URL=http://localhost:8000
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=

# LLM (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-flash-latest

# Local storage for baselines, reports and anomalies
DATABASE_PATH=./data/orbit.db

# Shared secret expected from the Plane backend proxy (header X-Orbit-Token)
ORBIT_INTERNAL_TOKEN=change-me
